# Copy to .env and fill in. .env is gitignored. Every setting has a working default for local fake mode.

# --- Models ------------------------------------------------------------------------------------------------
# fake: no GPU, stand-in singer/listener for UI and pipeline testing.  local: YuE2 + Whisper + SheetSage2 on a GPU.
YUE2_MODELS=fake
YUE2_TAKES=3
YUE2_BPM=90

# --- Lyric writer (any OpenAI-compatible endpoint). Leave LLM_API_KEY empty with fake models to use the no-LLM writer.
# W&B Inference:
LLM_BASE_URL=https://api.inference.wandb.ai/v1
LLM_API_KEY=
LLM_PROJECT=
WRITER_MODEL=google/gemma-4-31B-it
# DigitalOcean Serverless Inference (OpenAI-compatible):
# LLM_BASE_URL=https://inference.do-ai.run/v1
# LLM_API_KEY=<model access key>
# WRITER_MODEL=llama3.3-70b-instruct

# --- Storage -----------------------------------------------------------------------------------------------
# local: files under YUE2_STORAGE_DIR.  s3: any S3-compatible bucket, e.g. DigitalOcean Spaces.
YUE2_STORAGE=local
# S3_ENDPOINT=https://tor1.digitaloceanspaces.com
# S3_REGION=tor1
# S3_BUCKET=
# S3_ACCESS_KEY=
# S3_SECRET_KEY=

# --- Database (compose runs Postgres for you; point this elsewhere for a managed database) ---------------
# DATABASE_URL=postgresql://yue2:yue2@db:5432/yue2

# --- One-off GPU jobs: python -m yue2 dispatch (see deploy/sandboxes) --------------------------------------
# process (local subprocesses, for development), modal or coreweave
YUE2_RUNNER=process
# Shared by the web app and the dispatcher; signs each job's token. Generate with: openssl rand -hex 32
YUE2_RUNNER_SECRET=
# The web app's address as the jobs see it (public for Modal and CoreWeave).
YUE2_API_URL=http://localhost:8080
YUE2_MAX_PARALLEL=2
YUE2_JOB_TIMEOUT=3600
# The GPU worker image in a registry (built from docker/worker-gpu.Dockerfile). Optional for Modal, which can build it.
# YUE2_WORKER_IMAGE=registry.digitalocean.com/<registry>/yue2-worker-gpu:latest
# Modal (auth: modal token new, or MODAL_TOKEN_ID / MODAL_TOKEN_SECRET)
# MODAL_GPU=L40S
# MODAL_VOLUME=yue2-models
# CoreWeave (auth: CWSANDBOX_API_KEY, or CWSANDBOX_AUTH=wandb with WANDB_API_KEY)
# CWSANDBOX_API_KEY=
# CWSANDBOX_GPU_TYPE=
# CWSANDBOX_GPU_MEMORY_GB=40
# CWSANDBOX_VOLUME_ID=

# --- Tracing (optional) ------------------------------------------------------------------------------------
# WEAVE_PROJECT=entity/yue2
# WANDB_API_KEY=

# --- Melody --------------------------------------------------------------------------------------------------
YUE2_MELODY=island-in-the-sun

# --- molab pairing (legacy notebooks in molab/) ----------------------------------------------------------
# MARIMO_TOKEN=
